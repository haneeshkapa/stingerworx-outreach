entrypoint = "main.py"
modules = ["python-3.11", "nodejs-20", "postgresql-16"]

[nix]
channel = "stable-25_05"
packages = ["alsa-lib", "at-spi2-atk", "atk", "cairo", "chromium", "copilot-cli", "cups", "dbus", "driversi686Linux.mesa", "ffmpeg", "ffmpeg-full", "fluxbox", "freetype", "gitFull", "glibcLocales", "lcms2", "libgbm", "libimagequant", "libjpeg", "libopus", "libtiff", "libvpx", "libwebp", "libxcrypt", "libxkbcommon", "mesa", "nspr", "nss", "openjpeg", "pango", "pkg-config", "playwright-driver", "tcl", "tigervnc", "tk", "xcodebuild", "xfce.xfce4-panel", "xfce.xfce4-session", "xfce.xfdesktop", "xfce.xfwm4", "xorg.libX11", "xorg.libXcomposite", "xorg.libXdamage", "xorg.libXfixes", "xorg.libxcb", "xorg.xauth", "xorg.xinit", "xorg.xorgserver", "xterm", "zlib"]

[unitTest]
language = "python3"

[gitHubImport]
requiredFiles = [".replit", "replit.nix"]

[deployment]
run = ["python3", "main.py"]
deploymentTarget = "cloudrun"

[agent]
expertMode = true
integrations = ["python_openai_ai_integrations:1.0.0"]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "backend"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "frontend"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "vnc"

[[workflows.workflow]]
name = "backend"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd backend && uvicorn main:app --host 0.0.0.0 --port 8000"
waitForPort = 8000

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow]]
name = "frontend"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd frontend && npm run dev"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow]]
name = "vnc"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "./start_vnc.sh"

[workflows.workflow.metadata]
outputType = "vnc"

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 5001
externalPort = 3003

[[ports]]
localPort = 8000
externalPort = 8000

[[ports]]
localPort = 35419
externalPort = 3002

[[ports]]
localPort = 36163
externalPort = 5000

[[ports]]
localPort = 38139
externalPort = 3001

[[ports]]
localPort = 41435
externalPort = 4200

[[ports]]
localPort = 44745
externalPort = 3000
